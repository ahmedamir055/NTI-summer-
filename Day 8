Part 3 — Event Loop

let x = 10;
function fun1() {
    console.log("fun1:", x);
}
function fun2() {
    setTimeout(() => {
        x = 15;
        console.log("fun2:", x);
    }, 0);
}
function fun3() {
    console.log("fun3:", x + 2);
}
fun1();
fun2();
fun3();

--------------------------------------------------------------

Part 4 — Callback

let x = 10;
function fun1(next) {
    console.log("fun1:", x);
    next();
}
function fun2(done) {
    setTimeout(() => {
        x = 15;
        console.log("fun2:", x);
        done();
    }, 0);
}
function fun3() {
    console.log("fun3:", x + 2);
}
fun1(() => {
    fun2(fun3);
});


Part 8 — Async / Await
async function getPost() {
    console.log("Start");
    const response = await fetch(
        "https://jsonplaceholder.typicode.com/posts/1"
    );
    const data = await response.json();
    console.log(data);
    console.log("End");
}
getPost();


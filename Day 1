Task 23:
function saveUsername(){

    var username = document.getElementById("username").value;

    if(username == ""){
        document.getElementById("result").innerText =
        "Username is required";
    }
    else{
        document.getElementById("result").innerText =
        "Saved successfully: " + username;
    }

    console.log({
        username: username,
        status: "saved"
    });
}


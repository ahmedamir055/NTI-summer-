Task 7:
var text = prompt("Enter text");
var words = text.split(" ");
var result = "";
for (var i = 0; i < words.length; i++) {
    var reverse = "";
    for (var j = words[i].length - 1; j >= 0; j--) {
        reverse += words[i][j];
    }
    result += reverse + " ";
}
console.log(result);

